{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reconcilers",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Attached to reconcilers.billyost.com 2026-09-20. workers.dev stays on so the old
  // address keeps working; site.config.json points canonical and the sitemap at the new one.
  // Still to do: flip capeindex.com's /reconcilers.zip redirect from 302 to 301.
  "routes": [{ "pattern": "reconcilers.billyost.com", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
